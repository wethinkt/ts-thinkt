{
  "name": "@wethinkt/ts-thinkt",
  "version": "0.1.20",
  "description": "TypeScript library for parsing and working with LLM conversation traces",
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./api": {
      "import": "./dist/api/index.js",
      "types": "./dist/api/index.d.ts"
    },
    "./parsers": {
      "import": "./dist/parsers/index.js",
      "types": "./dist/parsers/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "npm run lint && tsc",
    "build:fast": "tsc",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "typecheck": "tsc --noEmit",
    "ci:check": "npm run lint && npm run typecheck && npm run test:run",
    "preversion": "npm run ci:check",
    "api:download": "curl -L -o src/api/swagger.json https://raw.githubusercontent.com/wethinkt/go-thinkt/main/internal/server/docs/swagger.json",
    "api:convert": "swagger2openapi src/api/swagger.json -o src/api/openapi.json",
    "api:generate": "npm run api:download && npm run api:generate:local",
    "api:generate:local": "npm run api:convert && openapi-typescript src/api/openapi.json -o src/api/generated.ts"
  },
  "keywords": [
    "llm",
    "thinkt",
    "claude",
    "kimi",
    "gemini",
    "openapi",
    "parser",
    "conversation",
    "trace"
  ],
  "author": "Neomantra Corp",
  "license": "MIT",
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/wethinkt/ts-thinkt"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@typescript-eslint/eslint-plugin": "^8.54.0",
    "@typescript-eslint/parser": "^8.54.0",
    "@vitest/coverage-v8": "^4.0.18",
    "eslint": "^9.39.2",
    "openapi-typescript": "^7.10.1",
    "swagger2openapi": "^7.0.8",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.54.0",
    "vitest": "^4.0.18",
    "yaml": "^2.8.2"
  }
}
